# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Only OPENROUTER_API_KEY is required to run the agent. Everything else has
# a sensible default and can be changed here.

# --- OpenRouter -----------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=deepseek/deepseek-v4.1-flash

# --- Agent ----------------------------------------------------------------
DEFAULT_MAX_STEPS=15
MAX_HISTORY_TURNS=8
MAX_OBSERVATION_CHARS=20000
REQUEST_TIMEOUT=60

# --- Wikipedia / Wikimedia ------------------------------------------------
# Optional OAuth 2.0 access token. Public reads work without it. When set, it
# is sent as "Authorization: Bearer <token>".
WIKIPEDIA_API_KEY=
WIKIPEDIA_LANGUAGE=en
# Wikimedia asks for a descriptive User-Agent with contact information.
WIKIPEDIA_USER_AGENT=web-search-qa/0.1 (local research agent; contact: richguilmain@gmail.com) bot
WIKIPEDIA_PAGE_CHARS=12000
WIKIPEDIA_MAX_LINKS=40

# --- Web search -----------------------------------------------------------
# ddgs is keyless and is the default. Set SEARCH_PROVIDER=tavily or brave and
# provide the matching key to use a hosted provider instead.
SEARCH_PROVIDER=ddgs
SEARCH_RESULTS=5
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Page fetching --------------------------------------------------------
# A descriptive, contactable User-Agent is required by Wikimedia and improves
# results on other sites. Override if a specific site needs a different one.
FETCH_USER_AGENT=web-search-qa/0.1 (local research agent; contact: richguilmain@gmail.com) bot
FETCH_MAX_BYTES=5000000
FETCH_TIMEOUT=30
FETCH_PAGE_CHARS=12000
FETCH_MAX_REDIRECTS=5
FETCH_MAX_LINKS=30
